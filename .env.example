# Every key is optional. Anything left blank falls back to a local mock,
# so the demo still works offline or while an API is rate-limiting you.

# Storage for saved projects and rendered videos. Required when deployed to Vercel (each request
# can run on a different instance, so files on local disk vanish between requests): create a Blob
# store with Public access under Storage in the Vercel project and it sets this for you.
# Leave blank locally to keep everything in .data/.
BLOB_READ_WRITE_TOKEN=

# Chat assistant: Claude if set, otherwise Gemini (uses GEMINI_API_KEY below).
# Without either, a basic assistant handles links, photos and simple commands.
ANTHROPIC_API_KEY=
# Gemini model for the chat assistant when there's no Anthropic key
GEMINI_CHAT_MODEL=gemini-flash-latest

# Image-to-video (checked in this order: Luma, Replicate, then Google Veo)
# AI_VIDEO=off skips them (stock footage or photo motion only), e.g. when Veo has no billing:
# its quota errors can otherwise stall a render past Vercel's time limit.
AI_VIDEO=
LUMA_API_KEY=
REPLICATE_API_TOKEN=
# Any Replicate image-to-video model that takes { image, prompt }
REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-i2v-fast
# Any Replicate text-to-video model that takes { prompt } (cooking + diner shots)
REPLICATE_TEXT_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast
# Google Veo via the Gemini API (aistudio.google.com/apikey; Veo needs billing enabled)
GEMINI_API_KEY=
# veo-3.1-fast-generate-preview (default), veo-3.1-lite-generate-preview (cheaper), veo-3.1-generate-preview (best)
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Seconds per clip: 4, 6 or 8 (billed per second). Forced to 8 when VIDEO_RESOLUTION=1080p.
GEMINI_VIDEO_SECONDS=4
# Clip resolution for Veo and Luma: 720p (default) or 1080p (sharper, slower, costs more).
# The final ad is always 1920x1080, so 720p clips get upscaled.
VIDEO_RESOLUTION=720p

# Stock footage (free key: https://www.pexels.com/api/). Real cooking-over-fire and
# people-eating clips for each dish, used when there's no AI video key or a clip fails.
PEXELS_API_KEY=

# Voiceover: ElevenLabs if set, else Gemini text-to-speech (uses GEMINI_API_KEY above), else macOS `say`.
# Vercel has no system voice, so without one of these keys renders there have music only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Any Gemini prebuilt voice (Charon, Kore, Puck, Fenrir, ...)
GEMINI_TTS_VOICE=Charon

# Max seconds to wait on the video model before using the local Ken Burns fallback
VIDEO_API_TIMEOUT_SECONDS=150

# One-click publishing (Export → Publish). Each platform turns on once its keys are set;
# without them the dialog offers "Upload manually" (downloads the MP4, copies the caption,
# opens the site). Register this redirect URI with each app:
#   <PUBLIC_URL>/api/connect/<youtube|instagram|tiktok|facebook>/callback
# Instagram, TikTok and Facebook only accept https redirect URIs (use a tunnel in development).
# Base URL for those redirects; defaults to the URL the app was opened on.
PUBLIC_URL=
# Google Cloud OAuth client (YouTube Data API v3). Unverified apps can only post private videos.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta app with "Instagram API with Instagram Login" (needs a Business or Creator account)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok developer app with Login Kit + Content Posting API. Unaudited apps can only post private videos.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta app with Facebook Login; posts to one of your Facebook Pages (the first one, or this id)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
