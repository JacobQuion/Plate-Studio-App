# Every key is optional. Uploaded photos can render locally without API keys.
# Missing search keys use external Google Maps/Yelp search links.

# Chat assistant: Claude if set, otherwise Gemini (uses GEMINI_API_KEY below).
# Without either, a basic assistant handles links, photos and simple commands.
ANTHROPIC_API_KEY=
# Optional restaurant-name search inside the app. Without keys, searches open
# Google Maps or Yelp in a new tab; locations can still be added and saved locally.
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
# Gemini model for the chat assistant when there's no Anthropic key
GEMINI_CHAT_MODEL=gemini-flash-latest

# Image-to-video (checked in this order: Luma, Replicate, then Google Veo)
LUMA_API_KEY=
REPLICATE_API_TOKEN=
# Any Replicate image-to-video model that takes { image, prompt }
REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-i2v-fast
# Any Replicate text-to-video model that takes { prompt } (cooking + diner shots)
REPLICATE_TEXT_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast
# Google Veo via the Gemini API (aistudio.google.com/apikey; Veo needs billing enabled)
GEMINI_API_KEY=
# veo-3.1-fast-generate-preview (default), veo-3.1-lite-generate-preview (cheaper), veo-3.1-generate-preview (best)
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Seconds per clip: 4, 6 or 8 (billed per second)
GEMINI_VIDEO_SECONDS=4

# Stock footage (free key: https://www.pexels.com/api/). Real cooking-over-fire and
# people eating, socializing and waiters serving food, used when AI clips fail.
# Without any video keys, distinct bundled dining photos still work locally.
PEXELS_API_KEY=

# Voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Max seconds to wait on the video model before using the local Ken Burns fallback
VIDEO_API_TIMEOUT_SECONDS=150
